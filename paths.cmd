@echo off
rem ---------------------------------------------------------------------------
rem Where the tools are. Every script in MISTrcdev calls this file first.
rem
rem Everything inside MISTrcdev -- the sources under sources\, the binaries
rem under bin\ -- is found relative to this file. Only the tools from outside
rem are named here, at the places TOOLS.md suggests installing them to.
rem
rem Installed somewhere else? Do not edit this file: put the lines you need in
rem a paths.local.cmd next to it. That file is read last, wins, and is not
rem part of the repository.
rem ---------------------------------------------------------------------------

rem --- the tools, see TOOLS.md -----------------------------------------------
set GOWIN=C:\fpga\Gowin\Gowin_V1.9.11.03_Education_x64
set OSS=C:\fpga\oss-cad-suite
set BL616_SDK=C:\fpga\bl616\bouffalo_sdk
set BL616_TOOLCHAIN=C:\fpga\bl616\toolchain_gcc_t-head_windows
set ARDUINO_CLI=arduino-cli
set PYTHON=python

rem --- inside MISTrcdev ------------------------------------------------------
rem %~dp0 is the MISTrcdev directory, with a trailing backslash.
set MISTRCDEV=%~dp0
set BIN=%~dp0bin
set C64_CORE=%~dp0sources\C64Nano
set ST_CORE=%~dp0sources\MiSTeryNano
set COMPANION=%~dp0sources\FPGA-Companion
set ZIMODEM=%~dp0sources\Zimodem

if exist "%~dp0paths.local.cmd" call "%~dp0paths.local.cmd"

rem --- derived, nothing to adjust below --------------------------------------

rem Gowin's embedded Python fails when PYTHONIOENCODING is set ("can't
rem initialize sys standard streams"). A plain command prompt does not set it,
rem but some shells do, so clear it here.
set PYTHONIOENCODING=
set PYTHONDONTWRITEBYTECODE=

rem openFPGALoader only finds its DLLs with lib on PATH. Without it Windows
rem aborts with 0xC0000135 and prints nothing at all.
set PATH=%OSS%\lib;%OSS%\bin;%PATH%

set GW_SH=%GOWIN%\IDE\bin\gw_sh.exe
set PROG=%GOWIN%\Programmer\bin\programmer_cli.exe
set LOADER=%OSS%\bin\openFPGALoader.exe
set BLFLASH=%BL616_SDK%\tools\bflb_tools\bouffalo_flash_cube\BLFlashCommand.exe
set DEV=GW2AR-18C
set CABLE=1

if not exist "%BIN%" mkdir "%BIN%"
exit /b 0
