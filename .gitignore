# ROM images are not ours to publish.
# What belongs there and where it comes from is in each machine's README.md.
c64/flash/roms/
atarist/flash/roms/

# Backups taken from a board
c64/backup/
atarist/backup/

# Binaries: built by the build scripts or fetched by get_binaries.cmd, never
# kept. Their checksums are in bin.sha256.
bin/

# Where the tools are on one particular machine, see paths.cmd
paths.local.cmd

# Anything the card only needs for trying things out
c64/sdcard/*.bin
c64/sdcard/*.crt
c64/sdcard/*.prg
c64/sdcard/*.tap
c64/sdcard/*.flt
c64/sdcard/*.ini

# disk8.d64 is our own generated empty image and stays in
!c64/sdcard/disk8.d64

# Python leaves these next to a script it has run
__pycache__/
